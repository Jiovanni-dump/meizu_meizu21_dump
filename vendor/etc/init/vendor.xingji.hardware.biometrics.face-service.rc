service vendor.xingji.face-default /vendor/bin/hw/vendor.xingji.hardware.biometrics.face-service
    # "class hal" causes a race condition on some devices due to files created
    # in /data. As a workaround, postpone startup until later in boot once
    # /data is mounted.
    class late_start
    user system
    group system
    task_profiles ProcessCapacityHigh
    capabilities SYS_NICE BLOCK_SUSPEND WAKE_ALARM
    rlimit rtprio 10 10

on post-fs-data
    mkdir /data/vendor/face 0770 system system
